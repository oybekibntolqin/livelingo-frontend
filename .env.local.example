# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and only loaded for `npm run dev`.

# Backend base URL (Spring Boot)
VITE_API_BASE=http://localhost:8080

# Google OAuth Client ID — same one your Spring backend uses for
# google.client-id in application.properties. Get it from:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID-HERE.apps.googleusercontent.com
